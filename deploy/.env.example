# GiGood env template — copy and fill real values (never commit .env):
#   cp deploy/.env.example .env          # repo root: docker compose env_file (dev API container)
#   cp deploy/.env.example deploy/.env   # deploy/: interpolation for compose.prod.yml + reference

# --- Neon Postgres (pooled connection string) --------------------------------
# Use the `dev` branch locally; pass the `prod` branch URL to Render only.
ConnectionStrings__Default=Host=__NEON_HOST__;Database=gigood_dev;Username=__USER__;Password=__PASS__;Pooling=true
# 32+ char signing key (generate: openssl rand -base64 32)
Jwt__Key=__32PLUS_CHAR_DEV_KEY__
Jwt__Issuer=GiGood
Jwt__Audience=GiGoodMobile

# --- Local offline Postgres (deploy/compose.yml, profile `offline`) ----------
# Values mirror the `db` service hardcoded in compose.yml; use this connection
# string instead of Neon when running entirely offline:
#   ConnectionStrings__Default=Host=localhost;Database=gigood_dev;Username=postgres;Password=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gigood_dev

# --- Web (Vite) --------------------------------------------------------------
# Dev: http://localhost:5000 — prod: the Render API URL (set on the static site)
VITE_API_BASE_URL=http://localhost:5000

# --- Expo app (app_mobile/.env) ----------------------------------------------
# Android emulator: http://10.0.2.2:5000 — iOS sim: http://localhost:5000
# The EAS `preview` profile (app_mobile/eas.json) overrides these with the Render URL.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000
# 1 = offline demo data, 0 = call the API (0 for the hosted build)
EXPO_PUBLIC_USE_MOCK=0
